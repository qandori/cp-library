+	static std::pair<D, D> divide_short(D a, const D &b) {
+		std::size_t n = a.size(), m = b.size();
+		a.resize(n + 1);
+		D q(n - m + 1);
+		long double inverse = 1 / (static_cast<long double>(b.back()) * base + b[m - 2]);
+		for (std::size_t j = q.size(); j--;) {
+			long double high = (static_cast<long double>(a[j + m]) * base + a[j + m - 1]) * base + a[j + m - 2];
+			U digit = static_cast<U>(std::min(static_cast<long double>(base - 1), high * inverse));
+			W borrow = 0;
+			for (std::size_t i = 0; i < m; ++i) {
+				W product = W(digit) * b[i] + borrow;
+				W next = base_quotient(product);
+				U low = product - next * base;
+				borrow = next + (a[j + i] < low);
+				a[j + i] = a[j + i] + (a[j + i] < low ? base : 0) - low;
+			}
+			bool over = a[j + m] < borrow;
+			a[j + m] = a[j + m] + (over ? base : 0) - borrow;
+			while (over) {
+				--digit;
+				U carry = limb_arithmetic::add<base>(a.data() + j, b.data(), m);
+				a[j + m] += carry;
+				over = a[j + m] < base;
+				if (!over) a[j + m] -= base;
+			}
+			auto at_least = [&] {
+				if (a[j + m]) return true;
+				for (std::size_t i = m; i--;) if (a[j + i] != b[i]) return a[j + i] > b[i];
+				return true;
+			};
+			while (at_least()) {
+				++digit;
+				U borrow = limb_arithmetic::subtract<base>(a.data() + j, b.data(), m);
+				a[j + m] -= borrow;
+			}
+			q[j] = digit;
+		}
+		a.resize(m);
+		trim(a); trim(q);
+		return {std::move(q), std::move(a)};
+	}
